# Copy these into your host's environment settings (Render: Environment tab).

# Your Vercel site address (where clients open their links). Leave empty if the whole site runs on Render.
# Several addresses can be comma-separated, e.g. https://jackies-studio.vercel.app,https://jackiesstudio.in
FRONTEND_URL=https://jackies-studio.vercel.app

# Secret address of your admin page: pick your own word + numbers, e.g. https://yoursite.com/your-word-1234
# There is no link to it anywhere and /admin does not exist. Don't share it.
ADMIN_PATH=choose-your-own-secret-word

# Password for the admin page. Use something long.
ADMIN_PASSWORD=change-me-to-a-long-password

# Random string used to sign the admin login cookie. Any long random text.
SESSION_SECRET=paste-a-long-random-string-here

# UPI details shown to clients on the payment QR code
UPI_ID=yourname@okaxis
UPI_NAME=Jackie's Studio

# WhatsApp number for the "message me" button (country code, no + or spaces)
WHATSAPP=916363692408

# Where uploaded videos and the job list are stored. On Render, set this to the disk mount path.
DATA_DIR=./data

# Largest video you can upload, in MB
MAX_UPLOAD_MB=4096

# Port (most hosts set this for you)
PORT=3000
